# Copy to .env (git-ignored). Every RECALL_* setting is optional; defaults live in recall/config.py.

# Credentials are read by the SDKs themselves, not by recall:
# ANTHROPIC_API_KEY=...                      (or run `ant auth login`)
# AWS_PROFILE=...                            (or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)

# Face recognition: "rekognition" (AWS, default), "insightface" (local CPU), or "mock".
# InsightFace stores face embeddings locally in RECALL_LOCAL_FACE_DB_PATH; images are not retained.
RECALL_FACE_BACKEND=rekognition
# RECALL_LOCAL_FACE_DB_PATH=recall_faces.sqlite3
# RECALL_LOCAL_FACE_MATCH_THRESHOLD=0.55
# Mock needs no AWS and reports one of ids 1..RECALL_MOCK_FACE_COUNT, switching person every
# RECALL_MOCK_FACE_HOLD_WINDOWS frames.
# RECALL_MOCK_FACE_COUNT=3
# RECALL_MOCK_FACE_HOLD_WINDOWS=6

# Speech-to-text: "whisper" (local faster-whisper, default) or "parakeet" (local NVIDIA Parakeet TDT
# 0.6B, install the [parakeet] extra).
RECALL_STT_BACKEND=whisper
# RECALL_WHISPER_MODEL=base.en
# RECALL_PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v2   (English; -v3 adds 24 European languages)
# RECALL_PARAKEET_QUANTIZATION=int8

RECALL_AWS_REGION=us-east-1
RECALL_REKOGNITION_COLLECTION_ID=recall-ai-faces

# Conversation lifecycle — tune these in the actual demo room
RECALL_MIN_SPEECH_DURATION_S=1.2
RECALL_MIN_SILENCE_DURATION_S=6.0
RECALL_VAD_THRESHOLD=0.5

# Drop to ~60 for the demo so mid-conversation persona updates are visible
RECALL_PERSONA_UPDATE_INTERVAL_S=300
