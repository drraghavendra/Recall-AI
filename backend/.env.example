# Copy to .env (git-ignored). Every RECALL_* setting is optional; defaults live in recall/config.py.

# Credentials are read by the SDKs themselves, not by recall:
# ANTHROPIC_API_KEY=...                      (or run `ant auth login`)
# AWS_PROFILE=...                            (or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# SARVAM_API_KEY=...                         (only for RECALL_STT_BACKEND=sarvam)

# Face recognition: "rekognition" (AWS, default), "insightface" (local CPU), or "mock".
# InsightFace stores face embeddings locally in RECALL_LOCAL_FACE_DB_PATH; images are not retained.
RECALL_FACE_BACKEND=rekognition
# RECALL_LOCAL_FACE_DB_PATH=recall_faces.sqlite3
# RECALL_LOCAL_FACE_MATCH_THRESHOLD=0.55
# Mock needs no AWS and reports one of ids 1..RECALL_MOCK_FACE_COUNT, switching person every
# RECALL_MOCK_FACE_HOLD_WINDOWS frames.
# RECALL_MOCK_FACE_COUNT=3
# RECALL_MOCK_FACE_HOLD_WINDOWS=6

# Speech-to-text: "whisper" (local faster-whisper, default), "parakeet" (local NVIDIA Parakeet TDT
# 0.6B, install the [parakeet] extra) or "sarvam" (paid Sarvam API, install the [sarvam] extra).
RECALL_STT_BACKEND=whisper
# RECALL_WHISPER_MODEL=base.en
# Parakeet model: -v2 is English; -v3 adds 24 European languages
# RECALL_PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v2
# RECALL_PARAKEET_QUANTIZATION=int8
# RECALL_SARVAM_MODEL=saaras:v3
# Sarvam language: unknown (auto-detect), or hi-IN, en-IN, ta-IN, ...
# RECALL_SARVAM_LANGUAGE_CODE=unknown
# Sarvam mode: transcribe, codemix, translit, translate or verbatim
# RECALL_SARVAM_MODE=transcribe
# RECALL_SARVAM_TIMEOUT_S=10

RECALL_AWS_REGION=us-east-1
RECALL_REKOGNITION_COLLECTION_ID=recall-ai-faces

# Conversation lifecycle — tune these in the actual demo room
RECALL_MIN_SPEECH_DURATION_S=1.2
RECALL_MIN_SILENCE_DURATION_S=6.0
RECALL_VAD_THRESHOLD=0.5

# The persona job: every this many seconds after its previous run finished, new transcript lines are
# grouped by face and Claude decides whether they add anything. It also runs when a conversation ends.
RECALL_PERSONA_CYCLE_S=90

# Background speech: "other" speech quieter than this is not attributed to the face in focus.
# Each utterance's level is logged ("level -38.2 dBFS") so you can tune it for your mic and room.
# Off by default (the browser normalises loudness); set e.g. -50 for un-normalised audio.
# RECALL_MIN_OTHER_SPEECH_DBFS=-50
# Lip check (InsightFace only): speech while the focused face's mouth is still is background.
# The log prints "openness std" per utterance; lower RECALL_LIP_MIN_OPENNESS_STD if real speech is missed.
# RECALL_LIP_MIN_OPENNESS_STD=0.02
# RECALL_LIP_CHECK=true
# Lines go to the focused face, and are ignored if its mouth didn't move; set true to give them to
# whichever face's mouth moved most instead.
# RECALL_LIP_PICKS_SPEAKER=false
# Focused face: center (nearest the middle of the frame, i.e. who you're looking at) or largest.
# RECALL_FOCUS_RULE=center
